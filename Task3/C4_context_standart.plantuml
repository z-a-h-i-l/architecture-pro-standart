@startuml C4_context_standart
!include <c4/C4_Context.puml>

LAYOUT_WITH_LEGEND()

title Контекстная диаграмма: Открытие депозитов онлайн (MVP)

Person(Клиент, "Клиент", "Новый или существующий клиент банка")
System(Сайт, "Сайт", "PHP + React.js")
System(Интернет_банк, "Интернет-банк", "ASP.NET MVC + MS SQL")
System(Кол_центр, "Система кол-центра", "React + Spring Boot")
SystemDb(СМС_шлюз, "СМС-шлюз", "Внешний сервис телеком-оператора")

System_Boundary(bank, "Граница банка") {
  System(Сервис_заявок, "Сервис заявок на депозиты", "Новый микросервис\n(Java/Spring Boot)")
  System(АБС, "АБС", "Delphi + Oracle\n(бэк-офис)")
}

Клиент --> Сайт
Клиент --> Интернет_банк
Сайт --> Сервис_заявок : HTTP/REST
Интернет_банк --> Сервис_заявок : HTTP/REST
Сервис_заявок --> Кол_центр : Создание обращения\n(REST)
Сервис_заявок --> СМС_шлюз : Отправка SMS\n(через АБС или напрямую)
Сервис_заявок --> АБС : Асинхронная передача\nзаявок (файл/API)
@enduml