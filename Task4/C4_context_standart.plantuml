@startuml C4_context_stavki_standart
!include <c4/C4_Context.puml>

LAYOUT_WITH_LEGEND()
title Контекст: Передача ставок в кол-центры

Person(Клиент, "Клиент")

System_Boundary(bank, "Банк «Стандарт»") {
  System(Сервис_заявок, "Сервис заявок на депозиты", "Хранит и публикует ставки")
  System(Кол_центр, "Система кол-центра", "Внутренняя платформа")
}

System(Партнёрский_кол_центр, "Партнёрский кол-центр", "Внешняя CRM")
System(Email_SFTP, "Канал передачи\n(SFTP / Email)", "Защищённый обмен")

Клиент --> Кол_центр
Клиент --> Партнёрский_кол_центр

Сервис_заявок --> Кол_центр : REST API (GET /rates)
Сервис_заявок --> Email_SFTP : Экспорт файла со ставками
Email_SFTP --> Партнёрский_кол_центр : Получение файла
@enduml